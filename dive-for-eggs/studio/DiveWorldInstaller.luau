local function install(mount)
	local parent = game:GetService(mount.service)
	for _, name in mount.parents do
		parent = parent:WaitForChild(name)
	end
	local existing = parent:FindFirstChild(mount.name)
	if existing then
		existing:Destroy()
	end
	local root = Instance.new(mount.className)
	root.Name = mount.name
	if mount.source then
		root.Source = mount.source
	end
	for _, child in mount.children do
		local script = Instance.new(child.className)
		script.Name = child.name
		script.Source = child.source
		script.Parent = root
	end
	root.Parent = parent
	return root
end

for _, mount in MOUNTS do
	install(mount)
end

local started = os.clock()
local builder = require(game:GetService("ServerScriptService").DiveWorldBuild.WorldBuilder)
local world = builder.build()
print(string.format("[DiveWorld] Installed scripts and built %s in %.1fs.", world:GetFullName(), os.clock() - started))
return true
