-- Packs every script under src/ into one file that can be pasted into Roblox Studio's
-- command bar. Running it installs the scripts into the open place (same layout as
-- default.project.json) and builds the world in edit mode.
--   lune run tools/bundle-studio.luau

local fs = require("@lune/fs")
local process = require("@lune/process")

local ROOT = string.gsub((string.gsub(process.cwd, "/$", "")), "/tools$", "")
if not fs.isDir(ROOT .. "/src") then
	ROOT = string.gsub(process.cwd, "/$", "") .. "/dive-for-eggs"
end
local SRC = ROOT .. "/src"
local OUT = ROOT .. "/studio/DiveWorldInstaller.luau"

-- Where each top-level src folder is mounted, mirroring default.project.json.
local MOUNTS = {
	{ dir = "ReplicatedStorage/DiveWorld", service = "ReplicatedStorage", parents = {}, name = "DiveWorld" },
	{ dir = "ServerScriptService/DiveWorldBuild", service = "ServerScriptService", parents = {}, name = "DiveWorldBuild" },
	{
		dir = "StarterPlayer/StarterPlayerScripts/DiveWorldClient",
		service = "StarterPlayer",
		parents = { "StarterPlayerScripts" },
		name = "DiveWorldClient",
	},
}

local BRACKET = "====="
local function longString(source: string): string
	assert(not string.find(source, "]" .. BRACKET .. "]", 1, true), "source contains the long-string terminator")
	return "[" .. BRACKET .. "[\n" .. source .. "]" .. BRACKET .. "]"
end

local function classify(file: string): (string?, string?)
	local name, kind = string.match(file, "^(.-)%.(%a+)%.luau$")
	if name and kind == "server" then
		return "Script", name
	elseif name and kind == "client" then
		return "LocalScript", name
	end
	local module = string.match(file, "^(.-)%.luau$")
	if module then
		return "ModuleScript", module
	end
	return nil, nil
end

local lines = {}
local function emit(line: string)
	table.insert(lines, line)
end

emit("-- Dive for Eggs: six-plaza starter hub installer (generated by tools/bundle-studio.luau).")
emit("-- Paste into Studio's command bar (View > Command Bar) and press Enter, or put it in a")
emit("-- ModuleScript and run require(thatModule) from the command bar.")
emit("-- Installs the DiveWorld scripts into this place, then builds the world in edit mode.")
emit("-- Re-running replaces the scripts and rebuilds Workspace.DiveStarterWorld.")
emit("")
emit("local MOUNTS = {")
for _, mount in MOUNTS do
	local dir = SRC .. "/" .. mount.dir
	local rootClass, rootSource = "Folder", nil
	if fs.isFile(dir .. "/init.server.luau") then
		rootClass, rootSource = "Script", fs.readFile(dir .. "/init.server.luau")
	end
	emit("\t{")
	emit(string.format("\t\tservice = %q,", mount.service))
	emit(string.format("\t\tparents = { %s },", table.concat(
		(function()
			local quoted = {}
			for _, p in mount.parents do
				table.insert(quoted, string.format("%q", p))
			end
			return quoted
		end)(),
		", "
	)))
	emit(string.format("\t\tname = %q,", mount.name))
	emit(string.format("\t\tclassName = %q,", rootClass))
	if rootSource then
		emit("\t\tsource = " .. longString(rootSource) .. ",")
	end
	emit("\t\tchildren = {")
	local files = fs.readDir(dir)
	table.sort(files)
	for _, file in files do
		if file ~= "init.server.luau" then
			local className, name = classify(file)
			if className then
				emit(string.format("\t\t\t{ className = %q, name = %q, source = %s },", className, name, longString(fs.readFile(dir .. "/" .. file))))
			end
		end
	end
	emit("\t\t},")
	emit("\t},")
end
emit("}")
emit([[

local function install(mount)
	local parent = game:GetService(mount.service)
	for _, name in mount.parents do
		parent = parent:WaitForChild(name)
	end
	local existing = parent:FindFirstChild(mount.name)
	if existing then
		existing:Destroy()
	end
	local root = Instance.new(mount.className)
	root.Name = mount.name
	if mount.source then
		root.Source = mount.source
	end
	for _, child in mount.children do
		local script = Instance.new(child.className)
		script.Name = child.name
		script.Source = child.source
		script.Parent = root
	end
	root.Parent = parent
	return root
end

for _, mount in MOUNTS do
	install(mount)
end

local started = os.clock()
local builder = require(game:GetService("ServerScriptService").DiveWorldBuild.WorldBuilder)
local world = builder.build()
print(string.format("[DiveWorld] Installed scripts and built %s in %.1fs.", world:GetFullName(), os.clock() - started))
return true
]])

if not fs.isDir(ROOT .. "/studio") then
	fs.writeDir(ROOT .. "/studio")
end
fs.writeFile(OUT, table.concat(lines, "\n"))
print(string.format("Wrote %s (%d KB)", OUT, math.floor(#table.concat(lines, "\n") / 1024)))
