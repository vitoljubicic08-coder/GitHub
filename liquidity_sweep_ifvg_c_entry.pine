//@version=5
indicator("Liquidity Sweep iFVG C-Entry", overlay=true, max_boxes_count=50, max_lines_count=100, max_labels_count=50)

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// LIQUIDITY SWEEP iFVG C-ENTRY INDICATOR
// Marks inverse FVGs that form AFTER major liquidity sweeps with precise entry at 50% mid
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// INPUTS
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

// Instrument Presets
instrumentPreset = input.string("NQ", "Instrument Preset", options=["NQ", "XAUUSD", "Custom"], group="Instrument")

// Pivot Settings
pivotLeft = input.int(5, "Pivot Left Bars", minval=1, maxval=20, group="Liquidity Sweep")
pivotRight = input.int(3, "Pivot Right Bars", minval=1, maxval=20, group="Liquidity Sweep")
sweepBufferPoints = input.float(4.0, "Sweep Buffer (points)", minval=0, step=0.5, group="Liquidity Sweep")
sweepReclaimBars = input.int(3, "Sweep Reclaim Bars", minval=1, maxval=10, tooltip="Bars to close back inside after sweep", group="Liquidity Sweep")

// Displacement
atrLen = input.int(14, "ATR Length", group="Displacement")
displacementATR = input.float(1.0, "Displacement ATR Multiple", minval=0.3, maxval=3.0, step=0.1, group="Displacement")
closePositionMin = input.float(0.6, "Min Close Position", minval=0.5, maxval=0.95, step=0.05, tooltip="Close must be this high/low in candle", group="Displacement")

// iFVG Detection
maxLookaheadBars = input.int(20, "Max Lookahead for iFVG", minval=5, maxval=50, group="iFVG Detection")
maxExtendBars = input.int(200, "Max Box Extend Bars", minval=50, maxval=500, group="iFVG Detection")
maxBoxes = input.int(10, "Max Boxes to Keep", minval=5, maxval=30, group="iFVG Detection")

// MTF Bias
htfTimeframe = input.timeframe("5", "HTF Timeframe", group="MTF Bias")
biasMethod = input.string("HTF close vs VWAP", "Bias Method", options=["HTF close vs VWAP", "HTF structure", "None"], group="MTF Bias")
useHTFBias = input.bool(true, "Use HTF Bias Filter", group="MTF Bias")

// Sessions
sessionTZ = input.string("America/New_York", "Timezone", group="Sessions")
enableLondon = input.bool(true, "Enable London", group="Sessions")
londonSession = input.session("0200-0500", "London Session", group="Sessions")
enableNY = input.bool(true, "Enable NY", group="Sessions")
nySession = input.session("0930-1600", "NY Session", group="Sessions")
excludeAsia = input.bool(true, "Exclude Asia", group="Sessions")

// Signal Control
maxSignalsPerDay = input.int(2, "Max Signals Per Day", minval=1, maxval=10, group="Signal Control")
maxSignalsPerSession = input.int(1, "Max Signals Per Session", minval=1, maxval=5, group="Signal Control")
cooldownBars = input.int(20, "Cooldown Bars", minval=0, maxval=100, group="Signal Control")

// Risk Management
slBufferPoints = input.float(3.0, "SL Buffer (points)", minval=0, step=0.5, group="Risk Management")
rrRatio = input.float(3.0, "Risk:Reward Ratio", minval=1.0, maxval=10.0, step=0.5, group="Risk Management")

// Display
showMidLine = input.bool(true, "Show C-Entry Mid Line", group="Display")
showSLTP = input.bool(true, "Show SL/TP Lines", group="Display")
showLabels = input.bool(true, "Show SL/TP Labels", group="Display")
deleteOldTradeDrawings = input.bool(true, "Delete Old SL/TP on New Signal", group="Display")
debugMode = input.bool(false, "Debug Mode", group="Display")

// Apply instrument defaults
finalSweepBuffer = instrumentPreset == "NQ" ? 4.0 : instrumentPreset == "XAUUSD" ? 0.4 : sweepBufferPoints
finalSLBuffer = instrumentPreset == "NQ" ? 3.0 : instrumentPreset == "XAUUSD" ? 0.3 : slBufferPoints

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SESSION DETECTION
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

inLondon = enableLondon and not na(time(timeframe.period, londonSession, sessionTZ))
inNY = enableNY and not na(time(timeframe.period, nySession, sessionTZ))
inSession = inLondon or inNY

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// PIVOT DETECTION
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

pivotHighValue = ta.pivothigh(high, pivotLeft, pivotRight)
pivotLowValue = ta.pivotlow(low, pivotLeft, pivotRight)

var float lastSwingHigh = na
var int lastSwingHighBar = na
var float lastSwingLow = na
var int lastSwingLowBar = na

if not na(pivotHighValue)
    lastSwingHigh := pivotHighValue
    lastSwingHighBar := bar_index - pivotRight

if not na(pivotLowValue)
    lastSwingLow := pivotLowValue
    lastSwingLowBar := bar_index - pivotRight

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// LIQUIDITY SWEEP DETECTION
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

var bool bearishSweepActive = false
var float bearishSweepLevel = na
var int bearishSweepBar = na
var bool bearishSweepReclaimed = false

var bool bullishSweepActive = false
var float bullishSweepLevel = na
var int bullishSweepBar = na
var bool bullishSweepReclaimed = false

// Check for bearish sweep (sweep above swing high)
if not na(lastSwingHigh) and not bearishSweepActive and inSession
    if high >= lastSwingHigh + finalSweepBuffer
        bearishSweepActive := true
        bearishSweepLevel := lastSwingHigh
        bearishSweepBar := bar_index
        bearishSweepReclaimed := false

// Check for reclaim on bearish sweep
if bearishSweepActive and not bearishSweepReclaimed
    if close < bearishSweepLevel
        bearishSweepReclaimed := true

// Check for bullish sweep (sweep below swing low)
if not na(lastSwingLow) and not bullishSweepActive and inSession
    if low <= lastSwingLow - finalSweepBuffer
        bullishSweepActive := true
        bullishSweepLevel := lastSwingLow
        bullishSweepBar := bar_index
        bullishSweepReclaimed := false

// Check for reclaim on bullish sweep
if bullishSweepActive and not bullishSweepReclaimed
    if close > bullishSweepLevel
        bullishSweepReclaimed := true

// Timeout sweeps if reclaim doesn't happen within bars
if bearishSweepActive and not bearishSweepReclaimed and (bar_index - bearishSweepBar) > sweepReclaimBars
    bearishSweepActive := false

if bullishSweepActive and not bullishSweepReclaimed and (bar_index - bullishSweepBar) > sweepReclaimBars
    bullishSweepActive := false

validBearishSweep = bearishSweepActive and bearishSweepReclaimed
validBullishSweep = bullishSweepActive and bullishSweepReclaimed

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// DISPLACEMENT DETECTION
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

atrValue = ta.atr(atrLen)
bodySize = math.abs(close - open)
candleRange = high - low

hasDisplacement = bodySize >= displacementATR * atrValue

// Check close position in candle
closePosition = candleRange > 0 ? (close - low) / candleRange : 0.5

// Bullish displacement: strong up candle with close near high
bullishDisplacement = hasDisplacement and close > open and closePosition >= closePositionMin

// Bearish displacement: strong down candle with close near low
bearishDisplacement = hasDisplacement and close < open and closePosition <= (1 - closePositionMin)

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// FVG DETECTION
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

// Bullish FVG: low[1] > high[3]
bullFVG = low[1] > high[3]
bullFVGTop = bullFVG ? low[1] : na
bullFVGBot = bullFVG ? high[3] : na

// Bearish FVG: high[1] < low[3]
bearFVG = high[1] < low[3]
bearFVGTop = bearFVG ? low[3] : na
bearFVGBot = bearFVG ? high[1] : na

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// iFVG DETECTION (INVERSE FVG AFTER SWEEP + DISPLACEMENT)
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

var float activeBullishIFVGTop = na
var float activeBullishIFVGBot = na
var int activeBullishIFVGBar = na
var bool bullishIFVGReady = false

var float activeBearishIFVGTop = na
var float activeBearishIFVGBot = na
var int activeBearishIFVGBar = na
var bool bearishIFVGReady = false

// For bullish iFVG: sweep below + displacement up + bearish FVG that becomes support
if validBullishSweep and bullishDisplacement and not bullishIFVGReady
    // Look for recent bearish FVG that can become inverse support
    if bearFVG and not na(bearFVGTop) and not na(bearFVGBot)
        activeBullishIFVGTop := bearFVGTop
        activeBullishIFVGBot := bearFVGBot
        activeBullishIFVGBar := bar_index
        bullishIFVGReady := true
        bullishSweepActive := false

// For bearish iFVG: sweep above + displacement down + bullish FVG that becomes resistance
if validBearishSweep and bearishDisplacement and not bearishIFVGReady
    // Look for recent bullish FVG that can become inverse resistance
    if bullFVG and not na(bullFVGTop) and not na(bullFVGBot)
        activeBearishIFVGTop := bullFVGTop
        activeBearishIFVGBot := bullFVGBot
        activeBearishIFVGBar := bar_index
        bearishIFVGReady := true
        bearishSweepActive := false

// Timeout iFVGs if too old
if bullishIFVGReady and (bar_index - activeBullishIFVGBar) > maxLookaheadBars
    bullishIFVGReady := false

if bearishIFVGReady and (bar_index - activeBearishIFVGBar) > maxLookaheadBars
    bearishIFVGReady := false

// Calculate C-entry mids
bullishMid = bullishIFVGReady ? (activeBullishIFVGTop + activeBullishIFVGBot) / 2 : na
bearishMid = bearishIFVGReady ? (activeBearishIFVGTop + activeBearishIFVGBot) / 2 : na

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// MTF BIAS FILTER
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

htfClose = request.security(syminfo.tickerid, htfTimeframe, close, lookahead=barmerge.lookahead_off)
htfVWAP = request.security(syminfo.tickerid, htfTimeframe, ta.vwap(hlc3), lookahead=barmerge.lookahead_off)

htfBullish = not useHTFBias or (biasMethod == "HTF close vs VWAP" ? htfClose > htfVWAP : true)
htfBearish = not useHTFBias or (biasMethod == "HTF close vs VWAP" ? htfClose < htfVWAP : true)

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SIGNAL MANAGEMENT
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

var int signalsToday = 0
var int signalsThisSession = 0
var int lastSignalBar = -999
var int sessionID = 0
var int lastSessionID = 0

if ta.change(time("D"))
    signalsToday := 0

sessionID := inLondon ? 1 : inNY ? 2 : 0

if sessionID != lastSessionID and sessionID != 0
    signalsThisSession := 0
    lastSessionID := sessionID

cooldownOK = bar_index - lastSignalBar >= cooldownBars
dailyLimitOK = signalsToday < maxSignalsPerDay
sessionLimitOK = signalsThisSession < maxSignalsPerSession
signalAllowed = inSession and cooldownOK and dailyLimitOK and sessionLimitOK

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ENTRY TRIGGER (TOUCH C-ENTRY MID)
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

// Bullish entry: touch mid from above and close back above
bullishEntry = bullishIFVGReady and not na(bullishMid) and low <= bullishMid and close > bullishMid and htfBullish

// Bearish entry: touch mid from below and close back below
bearishEntry = bearishIFVGReady and not na(bearishMid) and high >= bearishMid and close < bearishMid and htfBearish

// Final signals (global scope series bool for plotshape)
buySignal = signalAllowed and bullishEntry
sellSignal = signalAllowed and bearishEntry

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// BOX DRAWING
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

var array<box> bullishBoxes = array.new<box>()
var array<line> bullishMidLines = array.new<line>()
var array<box> bearishBoxes = array.new<box>()
var array<line> bearishMidLines = array.new<line>()

// Create bullish iFVG box when ready
if bullishIFVGReady and bar_index == activeBullishIFVGBar
    newBox = box.new(activeBullishIFVGBar, activeBullishIFVGTop, bar_index + 1, activeBullishIFVGBot, border_color=color.new(color.green, 30), bgcolor=color.new(color.green, 85), border_width=1)
    array.push(bullishBoxes, newBox)

    if showMidLine
        midLine = line.new(activeBullishIFVGBar, bullishMid, bar_index + 1, bullishMid, color=color.new(color.yellow, 40), style=line.style_dotted, width=1)
        array.push(bullishMidLines, midLine)

    // Clean up old boxes
    if array.size(bullishBoxes) > maxBoxes
        oldBox = array.shift(bullishBoxes)
        box.delete(oldBox)
        if showMidLine and array.size(bullishMidLines) > 0
            oldLine = array.shift(bullishMidLines)
            line.delete(oldLine)

// Extend bullish boxes
if array.size(bullishBoxes) > 0
    for i = 0 to array.size(bullishBoxes) - 1
        b = array.get(bullishBoxes, i)
        if not na(b)
            box.set_right(b, bar_index)
        if showMidLine and i < array.size(bullishMidLines)
            l = array.get(bullishMidLines, i)
            if not na(l)
                line.set_x2(l, bar_index)

// Create bearish iFVG box when ready
if bearishIFVGReady and bar_index == activeBearishIFVGBar
    newBox = box.new(activeBearishIFVGBar, activeBearishIFVGTop, bar_index + 1, activeBearishIFVGBot, border_color=color.new(color.red, 30), bgcolor=color.new(color.maroon, 85), border_width=1)
    array.push(bearishBoxes, newBox)

    if showMidLine
        midLine = line.new(activeBearishIFVGBar, bearishMid, bar_index + 1, bearishMid, color=color.new(color.yellow, 40), style=line.style_dotted, width=1)
        array.push(bearishMidLines, midLine)

    // Clean up old boxes
    if array.size(bearishBoxes) > maxBoxes
        oldBox = array.shift(bearishBoxes)
        box.delete(oldBox)
        if showMidLine and array.size(bearishMidLines) > 0
            oldLine = array.shift(bearishMidLines)
            line.delete(oldLine)

// Extend bearish boxes
if array.size(bearishBoxes) > 0
    for i = 0 to array.size(bearishBoxes) - 1
        b = array.get(bearishBoxes, i)
        if not na(b)
            box.set_right(b, bar_index)
        if showMidLine and i < array.size(bearishMidLines)
            l = array.get(bearishMidLines, i)
            if not na(l)
                line.set_x2(l, bar_index)

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SL/TP LINES
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

var line currentSL = na
var line currentTP = na
var label currentSLLabel = na
var label currentTPLabel = na

if buySignal
    entryPrice = bullishMid
    slPrice = bullishSweepLevel - finalSLBuffer
    riskDist = entryPrice - slPrice
    tpPrice = entryPrice + riskDist * rrRatio

    // Delete old drawings if enabled
    if deleteOldTradeDrawings
        if not na(currentSL)
            line.delete(currentSL)
        if not na(currentTP)
            line.delete(currentTP)
        if not na(currentSLLabel)
            label.delete(currentSLLabel)
        if not na(currentTPLabel)
            label.delete(currentTPLabel)

    // Draw new SL/TP
    if showSLTP
        currentSL := line.new(bar_index, slPrice, bar_index + 1, slPrice, color=color.red, style=line.style_solid, width=2, extend=extend.right)
        currentTP := line.new(bar_index, tpPrice, bar_index + 1, tpPrice, color=color.green, style=line.style_solid, width=2, extend=extend.right)

        if showLabels
            currentSLLabel := label.new(bar_index, slPrice, "SL", style=label.style_label_left, color=color.red, textcolor=color.white, size=size.tiny)
            currentTPLabel := label.new(bar_index, tpPrice, "TP", style=label.style_label_left, color=color.green, textcolor=color.white, size=size.tiny)

    // Update counters
    signalsToday += 1
    signalsThisSession += 1
    lastSignalBar := bar_index
    bullishIFVGReady := false

if sellSignal
    entryPrice = bearishMid
    slPrice = bearishSweepLevel + finalSLBuffer
    riskDist = slPrice - entryPrice
    tpPrice = entryPrice - riskDist * rrRatio

    // Delete old drawings if enabled
    if deleteOldTradeDrawings
        if not na(currentSL)
            line.delete(currentSL)
        if not na(currentTP)
            line.delete(currentTP)
        if not na(currentSLLabel)
            label.delete(currentSLLabel)
        if not na(currentTPLabel)
            label.delete(currentTPLabel)

    // Draw new SL/TP
    if showSLTP
        currentSL := line.new(bar_index, slPrice, bar_index + 1, slPrice, color=color.red, style=line.style_solid, width=2, extend=extend.right)
        currentTP := line.new(bar_index, tpPrice, bar_index + 1, tpPrice, color=color.green, style=line.style_solid, width=2, extend=extend.right)

        if showLabels
            currentSLLabel := label.new(bar_index, slPrice, "SL", style=label.style_label_left, color=color.red, textcolor=color.white, size=size.tiny)
            currentTPLabel := label.new(bar_index, tpPrice, "TP", style=label.style_label_left, color=color.green, textcolor=color.white, size=size.tiny)

    // Update counters
    signalsToday += 1
    signalsThisSession += 1
    lastSignalBar := bar_index
    bearishIFVGReady := false

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SIGNALS (GLOBAL SCOPE)
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

plotshape(buySignal, title="BUY", style=shape.labelup, location=location.belowbar, color=color.green, text="BUY", size=size.small)
plotshape(sellSignal, title="SELL", style=shape.labeldown, location=location.abovebar, color=color.red, text="SELL", size=size.small)

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// DEBUG
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

if debugMode
    bgcolor(validBullishSweep ? color.new(color.green, 95) : na, title="Debug Bullish Sweep")
    bgcolor(validBearishSweep ? color.new(color.red, 95) : na, title="Debug Bearish Sweep")

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ALERTS
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

alertcondition(buySignal, title="iFVG BUY", message="Liquidity Sweep iFVG BUY signal - C-Entry touched")
alertcondition(sellSignal, title="iFVG SELL", message="Liquidity Sweep iFVG SELL signal - C-Entry touched")
