//@version=6
// =============================================================================
// NAM MOMENTUM V1 - PRODUCTION INDICATOR (QQQ / SPY intraday "noise-area" momentum)
// -----------------------------------------------------------------------------
// After Zarattini, Aziz & Barbon, "Beat the Market: An Effective Intraday
// Momentum Strategy for S&P500 ETF (SPY)" (2024), using the published default
// settings (no parameter tuning). The price trades inside a "noise area" most
// of the day; a half-hourly close outside it signals demand imbalance that
// tends to persist into the close.
//
// RULES (5-minute chart, regular session, America/New_York)
//   sigma[k]  = average over the previous 14 sessions of |close[k] / open - 1|
//               for the k-th 5-minute bar of the day.
//   upper[k]  = max(today's 09:30 open, yesterday's close) x (1 + sigma[k])
//   lower[k]  = min(today's 09:30 open, yesterday's close) x (1 - sigma[k])
//   Decisions only at the closes of the bars ending 10:00, 10:30, ..., 15:30:
//     flat  : close > upper -> LONG ; close < lower -> SHORT
//     long  : close < max(upper, VWAP) -> EXIT (unless close is still > upper)
//     short : close > min(lower, VWAP) -> EXIT (unless close is still < lower)
//   Any open position exits at the 15:50 bar close (filled at the 15:55 open).
//
// RESEARCH RESULTS (offline replication, unlevered, after 2 ticks of slippage
// per fill and 0.005 USD/share per side; see docs/sip_orb_precision_v1.md)
//   QQQ: 2023 +11.7%, 2024 +7.4% (development), 2025 +10.6%, 2026 Q1 +1.9%
//        (locked holdout), Sep-Nov 2026 +4.0% (independent Yahoo data).
//   About 40% of trades win: many small losses, fewer larger wins. Past results
//   do not guarantee future results.
//
// WHAT IS DRAWN
//   Green arrow below bar : NAM LONG   (decision at that bar's close)
//   Red arrow above bar   : NAM SHORT
//   Grey cross above bar  : NAM EXIT   (includes the 15:50 end-of-day exit)
//   Bands, VWAP and state are in the Data Window only.
//
// ALERTS: "NAM LONG", "NAM SHORT", "NAM EXIT", frequency "Once Per Bar Close".
// NON-REPAINTING: all state changes happen only on confirmed bars; no
// request.security, no offsets, no future data. Revised vendor data can change
// historical calculations.
// =============================================================================
indicator("NAM Momentum V1", shorttitle = "NAM V1", overlay = true)

// ==== BEGIN NAM SIGNAL ENGINE (must stay byte-identical in indicator and strategy) ====

// -----------------------------------------------------------------------------
// N1. Fixed parameters (published defaults; never optimise them).
// -----------------------------------------------------------------------------
TZ              = "America/New_York"
LOOKBACK        = 14     // sessions in the noise-area average
BARS_PER_DAY    = 78     // 5-minute bars from 09:30 to 15:55
OPEN_MOD        = 570    // 09:30
SESSION_END_MOD = 960    // 16:00 (exclusive)
FIRST_CHECK_MOD = 600    // first decision at the close of the bar ending 10:00
LAST_CHECK_MOD  = 930    // last decision at the close of the bar ending 15:30
EOD_SUBMIT_MOD  = 950    // the 15:50 bar: flatten, filled at the 15:55 open

// -----------------------------------------------------------------------------
// N2. Chart and instrument validation.
// -----------------------------------------------------------------------------
bool chartIsFiveMinute = timeframe.isminutes and timeframe.multiplier == 5
bool chartIsStandard   = chart.is_standard
bool symbolIsSupported = syminfo.ticker == "QQQ" or syminfo.ticker == "SPY"
bool symbolIsUsd       = syminfo.currency == "USD"

if not chartIsFiveMinute
    runtime.error("NAM V1 rejected: a 5-minute chart is required (current timeframe: " + timeframe.period + ").")
if not chartIsStandard
    runtime.error("NAM V1 rejected: use a standard candlestick chart (not Heikin Ashi, Renko, Kagi, Point & Figure, Line Break or Range).")
if not (symbolIsSupported and symbolIsUsd)
    runtime.error("NAM V1 rejected: only QQQ (recommended) and SPY were tested (current symbol: " + syminfo.tickerid + ").")

// -----------------------------------------------------------------------------
// N3. New York clock for the current bar (bar OPEN time).
// -----------------------------------------------------------------------------
int  nyMod       = hour(time, TZ) * 60 + minute(time, TZ)
int  nyDow       = dayofweek(time, TZ)
int  nyDateKey   = year(time, TZ) * 10000 + month(time, TZ) * 100 + dayofmonth(time, TZ)
bool isWeekdayNY = nyDow >= dayofweek.monday and nyDow <= dayofweek.friday
bool inRegular   = session.ismarket and isWeekdayNY and nyMod >= OPEN_MOD and nyMod < SESSION_END_MOD

// -----------------------------------------------------------------------------
// N4. State.
// -----------------------------------------------------------------------------
var matrix<float> moveHist = matrix.new<float>()                  // one row per completed session
var array<float>  todayMove = array.new<float>(BARS_PER_DAY, na)  // |close/open - 1| per bar today
var int   sessDateKey  = na
var float dayOpen      = na
var float prevClose    = na
var float lastRthClose = na
var float cumPV        = 0.0
var float cumV         = 0.0
var int   enginePos    = 0      // +1 long, -1 short, 0 flat (the engine's intended position)
var float upperBand    = na
var float lowerBand    = na

bool longEntry  = false
bool shortEntry = false
bool exitSignal = false
bool eodExit    = false

// -----------------------------------------------------------------------------
// N5. Engine: confirmed regular-session bars only.
// -----------------------------------------------------------------------------
if barstate.isconfirmed and inRegular
    if na(sessDateKey) or nyDateKey != sessDateKey
        // New session: archive yesterday's moves, carry yesterday's close.
        if not na(sessDateKey)
            if not na(dayOpen)
                moveHist.add_row(moveHist.rows(), todayMove.copy())
                if moveHist.rows() > LOOKBACK
                    moveHist.remove_row(0)
            prevClose := lastRthClose
        sessDateKey := nyDateKey
        dayOpen     := nyMod == OPEN_MOD ? open : na
        todayMove   := array.new<float>(BARS_PER_DAY, na)
        cumPV       := 0.0
        cumV        := 0.0
        enginePos   := 0
        upperBand   := na
        lowerBand   := na

    lastRthClose := close
    float barVol = na(volume) ? 0.0 : volume
    cumPV += hlc3 * barVol
    cumV  += barVol
    float vwapNow = cumV > 0 ? cumPV / cumV : na
    int k = math.floor((nyMod - OPEN_MOD) / 5.0)
    if not na(dayOpen)
        todayMove.set(k, math.abs(close / dayOpen - 1))

    int  closeMod = nyMod + 5
    bool isCheck  = closeMod % 30 == 0 and closeMod >= FIRST_CHECK_MOD and closeMod <= LAST_CHECK_MOD
    if isCheck and moveHist.rows() == LOOKBACK and not na(dayOpen) and not na(prevClose)
        float sigmaSum   = 0.0
        int   sigmaCount = 0
        for r = 0 to LOOKBACK - 1
            float x = moveHist.get(r, k)
            if not na(x)
                sigmaSum   += x
                sigmaCount += 1
        if sigmaCount > 0
            float sigma = sigmaSum / sigmaCount
            upperBand := math.max(dayOpen, prevClose) * (1 + sigma)
            lowerBand := math.min(dayOpen, prevClose) * (1 - sigma)
            if enginePos == 1
                float stopLong = na(vwapNow) ? upperBand : math.max(upperBand, vwapNow)
                // Exit, unless price is still above the band (then simply keep holding).
                if close < stopLong and not (close > upperBand)
                    exitSignal := true
                    enginePos  := 0
            else if enginePos == -1
                float stopShort = na(vwapNow) ? lowerBand : math.min(lowerBand, vwapNow)
                if close > stopShort and not (close < lowerBand)
                    exitSignal := true
                    enginePos  := 0
            if enginePos == 0
                if close > upperBand
                    longEntry := true
                    enginePos := 1
                else if close < lowerBand
                    shortEntry := true
                    enginePos  := -1

    if nyMod == EOD_SUBMIT_MOD and enginePos != 0
        eodExit   := true
        enginePos := 0

// ==== END NAM SIGNAL ENGINE ====

// =============================================================================
// OUTPUT: arrows for entries, a small grey cross for exits.
// =============================================================================
plotshape(longEntry, title = "NAM LONG", style = shape.arrowup, location = location.belowbar, color = color.rgb(0, 200, 0), size = size.small, display = display.all - display.status_line)
plotshape(shortEntry, title = "NAM SHORT", style = shape.arrowdown, location = location.abovebar, color = color.rgb(220, 0, 0), size = size.small, display = display.all - display.status_line)
plotshape(exitSignal or eodExit, title = "NAM EXIT", style = shape.xcross, location = location.abovebar, color = color.rgb(120, 120, 120), size = size.tiny, display = display.all - display.status_line)

alertcondition(longEntry, title = "NAM LONG", message = "NAM LONG | {{exchange}}:{{ticker}} | Timeframe {{interval}} | Decision close {{close}} | Bar open time {{time}} UTC")
alertcondition(shortEntry, title = "NAM SHORT", message = "NAM SHORT | {{exchange}}:{{ticker}} | Timeframe {{interval}} | Decision close {{close}} | Bar open time {{time}} UTC")
alertcondition(exitSignal or eodExit, title = "NAM EXIT", message = "NAM EXIT | {{exchange}}:{{ticker}} | Timeframe {{interval}} | Decision close {{close}} | Bar open time {{time}} UTC")

// Invisible diagnostics (Data Window only).
plot(longEntry ? 1 : shortEntry ? -1 : (exitSignal or eodExit) ? 9 : 0, "Diag: signal (+1 long, -1 short, 9 exit)", display = display.data_window)
plot(enginePos, "Diag: engine position", display = display.data_window)
plot(upperBand, "Diag: upper band (last check)", display = display.data_window)
plot(lowerBand, "Diag: lower band (last check)", display = display.data_window)
plot(moveHist.rows(), "Diag: sessions in history", display = display.data_window)
