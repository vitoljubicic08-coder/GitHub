//@version=5
indicator("SMT PD-Array StdDev Reversal (Top/Bottom Catcher)", overlay=true, max_lines_count=200, max_labels_count=100)

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// INPUTS
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

// SMT Settings
smtSymbol = input.string("ES1!", "SMT Comparison Symbol", tooltip="Set correct broker ticker (e.g., ES1!, CME_MINI:ES1!)", group="SMT Settings")
smtTimeframe = input.string("5", "SMT Timeframe", group="SMT Settings")
smtStrict = input.bool(false, "Strict SMT Required", tooltip="If true, SMT must be present for any signal", group="SMT Settings")
syncBars = input.int(12, "SMT Sync Window (bars)", minval=5, maxval=50, group="SMT Settings")

// Timeframes
contextTF = input.timeframe("15", "Context Timeframe (FVG)", group="Timeframes")
useTrendFilter = input.bool(false, "Use Trend Filter", group="Timeframes")
trendTF = input.timeframe("60", "Trend Filter Timeframe", group="Timeframes")

// Sessions
enableLondon = input.bool(true, "Enable London Session", group="Sessions")
londonSession = input.session("0200-0500", "London Session (NY Time)", group="Sessions")
enableNY = input.bool(true, "Enable NY Session", group="Sessions")
nySession = input.session("0830-1130", "NY Session (NY Time)", group="Sessions")
sessionTZ = input.string("America/New_York", "Timezone", group="Sessions")

// VWAP Deviation
devLen = input.int(200, "StdDev Length", minval=50, maxval=500, group="VWAP Deviation")
devMode = input.string("Mode 2", "Deviation Mode", options=["Mode 1", "Mode 2"], tooltip="Mode 1: stdev(close) | Mode 2: stdev(close-vwap)", group="VWAP Deviation")
sigmaEntry = input.float(2.5, "Entry Sigma", minval=1.0, maxval=5.0, step=0.1, group="VWAP Deviation")
sigmaMax = input.float(3.5, "Max Sigma", minval=2.0, maxval=6.0, step=0.1, group="VWAP Deviation")

// PD Arrays
fvgProxPts = input.float(8.0, "FVG Proximity (points)", minval=0.0, maxval=50.0, step=0.5, group="PD Arrays")
usePDHPDL = input.bool(true, "Use PDH/PDL", group="PD Arrays")
pdProxPts = input.float(10.0, "PDH/PDL Proximity (points)", minval=0.0, maxval=50.0, step=0.5, group="PD Arrays")

// Liquidity Sweep
pivotLenL = input.int(7, "Pivot Left Bars", minval=2, maxval=20, group="Liquidity Sweep")
pivotLenR = input.int(4, "Pivot Right Bars", minval=2, maxval=20, group="Liquidity Sweep")
sweepLookback = input.int(200, "Sweep Lookback", minval=50, maxval=500, group="Liquidity Sweep")
sweepBufferPts = input.float(1.5, "Sweep Buffer (points)", minval=0.0, maxval=10.0, step=0.25, group="Liquidity Sweep")

// MSS Trigger
mssPivotL = input.int(3, "MSS Pivot Left", minval=1, maxval=10, group="MSS Trigger")
mssPivotR = input.int(2, "MSS Pivot Right", minval=1, maxval=10, group="MSS Trigger")
maxWaitBars = input.int(15, "Max Wait After Sweep", minval=5, maxval=50, group="MSS Trigger")

// Wick Quality
wickMinPct = input.float(0.35, "Min Wick %", minval=0.1, maxval=0.8, step=0.05, group="Wick Quality")
closePosMin = input.float(0.65, "Min Close Position", minval=0.5, maxval=0.95, step=0.05, group="Wick Quality")

// Risk Management
minStopPts = input.float(8.0, "Min Stop (points)", minval=2.0, maxval=20.0, step=0.5, group="Risk Management")
maxStopPts = input.float(14.0, "Max Stop (points)", minval=5.0, maxval=50.0, step=0.5, group="Risk Management")
slBufferPts = input.float(1.0, "SL Buffer (points)", minval=0.0, maxval=5.0, step=0.25, group="Risk Management")
skipWideStops = input.bool(true, "Skip Trade if Stop > Max", group="Risk Management")
rr = input.float(3.0, "Risk:Reward", minval=1.0, maxval=10.0, step=0.5, group="Risk Management")

// Signal Control
maxSignalsPerDay = input.int(2, "Max Signals Per Day", minval=1, maxval=10, group="Signal Control")
cooldownBars = input.int(30, "Cooldown Bars", minval=0, maxval=200, group="Signal Control")
onePerDirection = input.bool(true, "One Per Direction Per Session", group="Signal Control")

// Display
showVWAP = input.bool(true, "Show VWAP", group="Display")
showBands = input.bool(false, "Show Sigma Bands", group="Display")
showSLTP = input.bool(true, "Show SL/TP Lines", group="Display")
deleteLinesOnExit = input.bool(true, "Delete Lines On Exit", group="Display")

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SESSION DETECTION
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

inLondon = enableLondon and not na(time(timeframe.period, londonSession, sessionTZ))
inNY = enableNY and not na(time(timeframe.period, nySession, sessionTZ))
inSession = inLondon or inNY
sessionID = inLondon ? 1 : inNY ? 2 : 0

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// VWAP AND DEVIATION
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

vwapValue = ta.vwap(hlc3)
stdev = devMode == "Mode 1" ? ta.stdev(close, devLen) : ta.stdev(close - vwapValue, devLen)

upperEntry = vwapValue + sigmaEntry * stdev
upperMax = vwapValue + sigmaMax * stdev
lowerEntry = vwapValue - sigmaEntry * stdev
lowerMax = vwapValue - sigmaMax * stdev

inLongZone = close <= lowerEntry and close >= lowerMax
inShortZone = close >= upperEntry and close <= upperMax

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 15M FVG DETECTION
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

[ctxHigh1, ctxLow1, ctxHigh3, ctxLow3] = request.security(syminfo.tickerid, contextTF, [high[1], low[1], high[3], low[3]], lookahead=barmerge.lookahead_off)

var float bullFVGLow = na
var float bullFVGHigh = na
var float bearFVGLow = na
var float bearFVGHigh = na

// Bullish FVG: candle 1 high < candle 3 low
if not na(ctxHigh1) and not na(ctxLow3) and ctxHigh1 < ctxLow3
    bullFVGLow := ctxHigh1
    bullFVGHigh := ctxLow3

// Bearish FVG: candle 1 low > candle 3 high
if not na(ctxLow1) and not na(ctxHigh3) and ctxLow1 > ctxHigh3
    bearFVGLow := ctxHigh3
    bearFVGHigh := ctxLow1

bullFVGMid = not na(bullFVGLow) and not na(bullFVGHigh) ? (bullFVGLow + bullFVGHigh) / 2 : na
bearFVGMid = not na(bearFVGLow) and not na(bearFVGHigh) ? (bearFVGLow + bearFVGHigh) / 2 : na

nearBullFVG = not na(bullFVGMid) and math.abs(close - bullFVGMid) <= fvgProxPts
nearBearFVG = not na(bearFVGMid) and math.abs(close - bearFVGMid) <= fvgProxPts

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// DAILY LEVELS
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

pdh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_off)
pdl = request.security(syminfo.tickerid, "D", low[1], lookahead=barmerge.lookahead_off)

nearPDL = usePDHPDL and not na(pdl) and math.abs(close - pdl) <= pdProxPts
nearPDH = usePDHPDL and not na(pdh) and math.abs(close - pdh) <= pdProxPts

longLocationOK = nearBullFVG or nearPDL
shortLocationOK = nearBearFVG or nearPDH

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// PIVOT DETECTION (PRIMARY)
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

pivotHigh = ta.pivothigh(high, pivotLenL, pivotLenR)
pivotLow = ta.pivotlow(low, pivotLenL, pivotLenR)

var float lastSwingHigh = na
var float lastSwingLow = na
var int lastSwingHighBar = na
var int lastSwingLowBar = na

if not na(pivotHigh)
    lastSwingHigh := pivotHigh
    lastSwingHighBar := bar_index - pivotLenR

if not na(pivotLow)
    lastSwingLow := pivotLow
    lastSwingLowBar := bar_index - pivotLenR

// MSS Pivots (shorter for micro structure)
mssPH = ta.pivothigh(high, mssPivotL, mssPivotR)
mssPL = ta.pivotlow(low, mssPivotL, mssPivotR)

var float lastMSSHigh = na
var float lastMSSLow = na

if not na(mssPH)
    lastMSSHigh := mssPH
if not na(mssPL)
    lastMSSLow := mssPL

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SMT DIVERGENCE (5M PIVOTS)
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

smtPH_Primary = request.security(syminfo.tickerid, smtTimeframe, ta.pivothigh(high, pivotLenL, pivotLenR), lookahead=barmerge.lookahead_off)
smtPL_Primary = request.security(syminfo.tickerid, smtTimeframe, ta.pivotlow(low, pivotLenL, pivotLenR), lookahead=barmerge.lookahead_off)
smtPH_Compare = request.security(smtSymbol, smtTimeframe, ta.pivothigh(high, pivotLenL, pivotLenR), lookahead=barmerge.lookahead_off)
smtPL_Compare = request.security(smtSymbol, smtTimeframe, ta.pivotlow(low, pivotLenL, pivotLenR), lookahead=barmerge.lookahead_off)

var float smtPrimaryPrevHigh = na
var float smtPrimaryCurrHigh = na
var float smtComparePrevHigh = na
var float smtCompareCurrHigh = na
var int smtHighUpdateBar = na

var float smtPrimaryPrevLow = na
var float smtPrimaryCurrLow = na
var float smtComparePrevLow = na
var float smtCompareCurrLow = na
var int smtLowUpdateBar = na

if not na(smtPH_Primary)
    smtPrimaryPrevHigh := smtPrimaryCurrHigh
    smtPrimaryCurrHigh := smtPH_Primary
    smtHighUpdateBar := bar_index

if not na(smtPH_Compare)
    smtComparePrevHigh := smtCompareCurrHigh
    smtCompareCurrHigh := smtPH_Compare

if not na(smtPL_Primary)
    smtPrimaryPrevLow := smtPrimaryCurrLow
    smtPrimaryCurrLow := smtPL_Primary
    smtLowUpdateBar := bar_index

if not na(smtPL_Compare)
    smtComparePrevLow := smtCompareCurrLow
    smtCompareCurrLow := smtPL_Compare

// Bearish SMT: primary makes higher high, comparison doesn't
bearishSMT = not na(smtPrimaryCurrHigh) and not na(smtPrimaryPrevHigh) and not na(smtCompareCurrHigh) and not na(smtComparePrevHigh) and smtPrimaryCurrHigh > smtPrimaryPrevHigh and smtCompareCurrHigh <= smtComparePrevHigh and not na(smtHighUpdateBar) and (bar_index - smtHighUpdateBar) <= syncBars

// Bullish SMT: primary makes lower low, comparison doesn't
bullishSMT = not na(smtPrimaryCurrLow) and not na(smtPrimaryPrevLow) and not na(smtCompareCurrLow) and not na(smtComparePrevLow) and smtPrimaryCurrLow < smtPrimaryPrevLow and smtCompareCurrLow >= smtComparePrevLow and not na(smtLowUpdateBar) and (bar_index - smtLowUpdateBar) <= syncBars

smtLongOK = not smtStrict or bullishSMT
smtShortOK = not smtStrict or bearishSMT

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// LIQUIDITY SWEEP DETECTION
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

var bool longSweepArmed = false
var float sweepLowLevel = na
var int sweepLowBar = na

var bool shortSweepArmed = false
var float sweepHighLevel = na
var int sweepHighBar = na

// Detect sweep of last swing low
if not na(lastSwingLow) and not na(lastSwingLowBar) and (bar_index - lastSwingLowBar) <= sweepLookback
    if low <= lastSwingLow - sweepBufferPts
        sweepLowLevel := lastSwingLow
        sweepLowBar := bar_index
        longSweepArmed := false

// Reclaim after sweep (for long)
if not na(sweepLowLevel) and not na(sweepLowBar) and (bar_index - sweepLowBar) <= maxWaitBars
    if close > sweepLowLevel
        longSweepArmed := true

// Detect sweep of last swing high
if not na(lastSwingHigh) and not na(lastSwingHighBar) and (bar_index - lastSwingHighBar) <= sweepLookback
    if high >= lastSwingHigh + sweepBufferPts
        sweepHighLevel := lastSwingHigh
        sweepHighBar := bar_index
        shortSweepArmed := false

// Reclaim after sweep (for short)
if not na(sweepHighLevel) and not na(sweepHighBar) and (bar_index - sweepHighBar) <= maxWaitBars
    if close < sweepHighLevel
        shortSweepArmed := true

// Disarm if too much time passed
if longSweepArmed and not na(sweepLowBar) and (bar_index - sweepLowBar) > maxWaitBars
    longSweepArmed := false

if shortSweepArmed and not na(sweepHighBar) and (bar_index - sweepHighBar) > maxWaitBars
    shortSweepArmed := false

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// MSS TRIGGER
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

mssLongBreak = longSweepArmed and not na(lastMSSHigh) and close > lastMSSHigh
mssShortBreak = shortSweepArmed and not na(lastMSSLow) and close < lastMSSLow

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// WICK QUALITY FILTER
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

candleRange = high - low
lowerWick = math.min(open, close) - low
upperWick = high - math.max(open, close)
closePos = candleRange > 0 ? (close - low) / candleRange : 0.5

wickLongOK = candleRange > 0 and lowerWick / candleRange >= wickMinPct and closePos >= closePosMin
wickShortOK = candleRange > 0 and upperWick / candleRange >= wickMinPct and closePos <= (1 - closePosMin)

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SIGNAL MANAGEMENT
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

var int signalsToday = 0
var int lastSignalBar = -999
var bool inTrade = false
var int tradeDir = 0
var float entryPrice = na
var float slPrice = na
var float tpPrice = na
var bool longFiredThisSession = false
var bool shortFiredThisSession = false
var int lastSessionID = 0

// Reset daily
if ta.change(time("D", sessionTZ))
    signalsToday := 0
    longFiredThisSession := false
    shortFiredThisSession := false

// Reset per session
if sessionID != lastSessionID and sessionID != 0
    longFiredThisSession := false
    shortFiredThisSession := false
    lastSessionID := sessionID

// Check trade exit
if inTrade
    if tradeDir == 1
        if low <= slPrice or high >= tpPrice
            inTrade := false
            tradeDir := 0
    else if tradeDir == -1
        if high >= slPrice or low <= tpPrice
            inTrade := false
            tradeDir := 0

// Signal allowed check
cooldownOK = (bar_index - lastSignalBar) >= cooldownBars
dailyLimitOK = signalsToday < maxSignalsPerDay
directionOK_long = not onePerDirection or not longFiredThisSession
directionOK_short = not onePerDirection or not shortFiredThisSession
signalAllowed = not inTrade and inSession and cooldownOK and dailyLimitOK

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ENTRY CONDITIONS
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

longSetup = inLongZone and longLocationOK and mssLongBreak and wickLongOK and smtLongOK and directionOK_long
shortSetup = inShortZone and shortLocationOK and mssShortBreak and wickShortOK and smtShortOK and directionOK_short

// Calculate stops and check validity
var bool validLongStop = false
var bool validShortStop = false

if longSetup and not na(sweepLowLevel)
    rawSL = sweepLowLevel - slBufferPts
    stopDist = close - rawSL
    validLongStop := stopDist >= minStopPts and (not skipWideStops or stopDist <= maxStopPts)

if shortSetup and not na(sweepHighLevel)
    rawSL = sweepHighLevel + slBufferPts
    stopDist = rawSL - close
    validShortStop := stopDist >= minStopPts and (not skipWideStops or stopDist <= maxStopPts)

// Generate signals
buySignal = signalAllowed and longSetup and validLongStop
sellSignal = signalAllowed and shortSetup and validShortStop

// Execute trades
if buySignal
    entryPrice := close
    rawSL = sweepLowLevel - slBufferPts
    stopDist = entryPrice - rawSL
    if stopDist < minStopPts
        slPrice := entryPrice - minStopPts
    else if stopDist > maxStopPts and not skipWideStops
        slPrice := entryPrice - maxStopPts
    else
        slPrice := rawSL
    tpPrice := entryPrice + rr * (entryPrice - slPrice)
    inTrade := true
    tradeDir := 1
    signalsToday := signalsToday + 1
    lastSignalBar := bar_index
    longFiredThisSession := true
    longSweepArmed := false

if sellSignal
    entryPrice := close
    rawSL = sweepHighLevel + slBufferPts
    stopDist = rawSL - entryPrice
    if stopDist < minStopPts
        slPrice := entryPrice + minStopPts
    else if stopDist > maxStopPts and not skipWideStops
        slPrice := entryPrice + maxStopPts
    else
        slPrice := rawSL
    tpPrice := entryPrice - rr * (slPrice - entryPrice)
    inTrade := true
    tradeDir := -1
    signalsToday := signalsToday + 1
    lastSignalBar := bar_index
    shortFiredThisSession := true
    shortSweepArmed := false

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// PLOTTING
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

// Signals
plotshape(buySignal, title="BUY", style=shape.labelup, location=location.belowbar, color=color.new(color.green, 0), text="BUY", size=size.normal)
plotshape(sellSignal, title="SELL", style=shape.labeldown, location=location.abovebar, color=color.new(color.red, 0), text="SELL", size=size.normal)

// VWAP and bands
plot(showVWAP ? vwapValue : na, "VWAP", color=color.new(color.purple, 0), linewidth=2)
plot(showBands ? upperEntry : na, "Upper Entry", color=color.new(color.red, 70), linewidth=1)
plot(showBands ? upperMax : na, "Upper Max", color=color.new(color.red, 40), linewidth=1)
plot(showBands ? lowerEntry : na, "Lower Entry", color=color.new(color.green, 70), linewidth=1)
plot(showBands ? lowerMax : na, "Lower Max", color=color.new(color.green, 40), linewidth=1)

// SL/TP Lines
var line slLine = na
var line tpLine = na

if showSLTP
    if buySignal or sellSignal
        if not na(slLine)
            line.delete(slLine)
        if not na(tpLine)
            line.delete(tpLine)
        slLine := line.new(bar_index, slPrice, bar_index + 1, slPrice, color=color.red, style=line.style_dashed, width=2, extend=extend.right)
        tpLine := line.new(bar_index, tpPrice, bar_index + 1, tpPrice, color=color.green, style=line.style_dashed, width=2, extend=extend.right)

    if deleteLinesOnExit and not inTrade
        if not na(slLine)
            line.delete(slLine)
            slLine := na
        if not na(tpLine)
            line.delete(tpLine)
            tpLine := na

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ALERTS
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

alertcondition(buySignal, title="BUY", message="SMT PD-Array StdDev BUY")
alertcondition(sellSignal, title="SELL", message="SMT PD-Array StdDev SELL")
